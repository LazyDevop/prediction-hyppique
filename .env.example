# Copier en .env (jamais committé) et renseigner les valeurs réelles.
# Chargé par docker-compose.yml (api + ingestion) via env_file.

# Requis pour /extraction/fiche et /extraction/programme (vision_client.py, Story 4.1).
# Sans cette clé, les deux endpoints renvoient 502 (VisionExtractionError).
ANTHROPIC_API_KEY=

# Optionnel — défaut dans vision_client.py si absent : claude-sonnet-5
# ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Optionnel — plafond quotidien d'appels vision (garde-fou de coût, AD-3).
# Défaut dans vision_client.py si absent : 50
# VISION_DAILY_CALL_LIMIT=50
